# Copy to .env and fill in. Never commit .env.

# Your Jellyfin server
SERVER_URL=http://your-jellyfin-host:8096

# Jellydash session secrets (generate each with: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
NEXTAUTH_URL=http://your-jellydash-host:4000

# Jellyfin admin API key (Jellyfin dashboard > API Keys)
JELLYFIN_ADMIN_API_KEY=

# Shared secret for incoming Jellyfin webhook calls (optional; auto-generated if empty)
WEBHOOK_SECRET=

# Poster image hosting (baked in at build time)
NEXT_PUBLIC_IMAGE_PROTOCOL=https
NEXT_PUBLIC_IMAGE_HOSTNAME=your-jellyfin-hostname
NEXT_PUBLIC_ALLOWED_DEV_ORIGIN=

# Optional
# REQUEST_LOGS=true
