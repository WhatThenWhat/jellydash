# Copy to .env and fill in. Never commit .env.
# Generate each secret with: openssl rand -base64 32   (INTERNAL_API_TOKEN: openssl rand -hex 32)

# The https URL you use to reach this app (your reverse proxy address). Used for cookies and CSRF checks.
PUBLIC_BASE_URL=https://jellydash.example.com

# Encrypts the stored Jellyfin API keys. Losing it means re-entering every server key. Back it up.
MASTER_KEY=

# Signs the login session cookie.
NEXTAUTH_SECRET=

# Admin login. Create the hash with:
#   docker run --rm -it ghcr.io/whatthenwhat/jellydash-multi node scripts/hash-password.mjs
# In a compose .env file, each $ in the hash must be written as $$.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Shared token for the Wizarr integration (Wizarr uses the same value). Leave empty to disable the API.
INTERNAL_API_TOKEN=

# Optional
# DEFAULT_SUBTITLE_LANGUAGE=eng       # applied to newly created users (three-letter code)
# EXTRA_CA_FILE=/certs/ca.pem         # extra CA bundle for Jellyfin servers behind a private CA
# ALLOW_INSECURE_HTTP=false           # permit http:// Jellyfin URLs (not recommended)
